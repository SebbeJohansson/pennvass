{
  "manifest_version": 3,
  "name": "fake-grammarly",
  "version": "0.2.0",
  "description": "Spelling, grammar, clarity and tone from my-agent on this machine: LanguageTool, Ollama, Laya and Claude.",
  "permissions": ["storage"],
  "host_permissions": ["http://127.0.0.1:8787/*", "http://localhost:8787/*"],
  "background": { "service_worker": "background.js" },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_idle",
      "all_frames": true,
      "match_about_blank": true
    }
  ],
  "action": { "default_popup": "popup.html", "default_title": "fake-grammarly" }
}
